{
  "name": "@inbox-copilot/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "concurrently -n api,worker,ai-stub -c blue,magenta,gray \"tsx watch --env-file-if-exists=../../.env src/index.ts\" \"tsx watch --env-file-if-exists=../../.env src/worker.ts\" \"tsx --env-file-if-exists=../../.env src/devtools/startAiStub.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "ai:stub": "tsx --env-file-if-exists=../../.env src/devtools/startAiStub.ts",
    "ai:sweep": "tsx --env-file-if-exists=../../.env src/scripts/aiSweep.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env src/scripts/demoSeed.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/generative-ai": "^0.24.1",
    "@inbox-copilot/db": "workspace:*",
    "@inbox-copilot/shared": "workspace:*",
    "bullmq": "^6.3.4",
    "express": "^5.1.0",
    "googleapis": "^180.0.0",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^4.2.0",
    "jose": "^6.1.0",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@inbox-copilot/config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
