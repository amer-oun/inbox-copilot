# ─── Local infrastructure (matches docker-compose.yml) ───────────────
DATABASE_URL="postgresql://inbox:inbox@localhost:5432/inbox_copilot?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Core API (apps/api) ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
LOG_LEVEL="debug"
#
# These two are the ones a deployment MUST change. They are not just cosmetic: the first
# becomes the OAuth redirect_uri and the Pub/Sub push endpoint, the second is where the
# browser is sent after a callback. In production the API refuses to start if either
# still points at localhost, or is not https (apps/api/src/lib/env.ts).
API_PUBLIC_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"

# Run the BullMQ consumers inside the API process instead of as a separate `worker.js`.
#
# Leave it false locally: `pnpm dev` runs the worker as its own process, which is the
# shape ARCHITECTURE §1 asks for — a 90-day backfill should not share an event loop with
# request handling. Set it to true on a host that only gives you one process (Render's
# free tier), where one service that also drains its queues beats a queue nothing reads.
#
# Only true/1 and false/0 are accepted. Anything else is a startup error rather than a
# silent false, because a silently-false flag means work is enqueued and never run.
WORKER_IN_PROCESS="false"

# ─── Secrets ─────────────────────────────────────────────────────────
# Generate every value in this block with:  node scripts/generate-secrets.mjs
#
# TOKEN_ENCRYPTION_KEY: AES-256-GCM key for the OAuth token vault. 32 bytes,
# base64. Bump the VERSION when you rotate it; rows keep their own keyVersion.
TOKEN_ENCRYPTION_KEY=""
TOKEN_ENCRYPTION_KEY_VERSION=1
# HMAC secret for the mailbox-connect OAuth `state` parameter (CSRF).
OAUTH_STATE_SECRET=""
# Auth.js session cookie secret.
AUTH_SECRET=""
# RS256 keypair for the internal web→api JWT. Private key: web only.
INTERNAL_JWT_PRIVATE_KEY=""
INTERNAL_JWT_PUBLIC_KEY=""

# ─── Web app (apps/web) ──────────────────────────────────────────────
AUTH_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"

# ─── OAuth: sign-in (apps/web, Auth.js) ──────────────────────────────
# Scopes are fixed in apps/web/auth.ts: openid profile email. No mail scopes.
# Google redirect URI:    http://localhost:3000/api/auth/callback/google
# Microsoft redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Microsoft sign-in is OPTIONAL: leave these empty and the provider is not registered
# and its button is not shown. Outlook mail sync is not implemented, so Microsoft
# sign-in only buys a second way to create an account. Google is required.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT="common"

# ─── OAuth: mailbox connection (apps/api) ────────────────────────────
# The same provider app may be reused, but these redirect URIs must also be
# registered — the mailbox flow is answered by the API, not the web app:
# Google redirect URI:    http://localhost:4000/oauth/google/callback
# Microsoft redirect URI: http://localhost:4000/oauth/microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ─── AI (apps/api) ───────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty for local development: outside production the AI
# layer talks to the local stub instead (started by `pnpm dev`, or `pnpm ai:stub`),
# which returns deterministic canned responses over the real Anthropic wire format.
# Nothing leaves the machine and no key is needed. Every log line from a stubbed
# call says so, and summaries it writes are prefixed "[stubbed summary]".
#
# To use the real API: put a key here and restart. That is the whole switch — the
# stub then refuses to start, and the client talks to api.anthropic.com.
ANTHROPIC_API_KEY=""
# Optional: send AI calls somewhere else entirely (a gateway, or the stub on a
# different host). Overrides the choice above. Empty = the rule described there.
ANTHROPIC_BASE_URL=""
# Port the local stub listens on (127.0.0.1 only). `pnpm dev` starts the stub only when
# the stub is the provider actually selected below — on Gemini or a real key it runs the
# api and worker alone, so there is never a second thing that could have answered.
AI_STUB_PORT=4010

# Which provider the AI layer talks to: anthropic | gemini | stub.
#
# Leave it EMPTY to keep the behaviour described above, which is what an existing
# setup expects: a key means the real API, no key outside production means the stub.
# Set it when you want the decision written down rather than inferred — "why is this
# database full of stubbed classifications" should be answerable from one line.
#
#   anthropic   api.anthropic.com, or ANTHROPIC_BASE_URL if set
#   gemini      Google's Gemini API on the free tier (needs GEMINI_API_KEY)
#   stub        the local canned-response server. Refused in production.
AI_PROVIDER=""
# Google AI Studio key, for AI_PROVIDER=gemini. Free tier — which is why every Gemini
# call is priced at zero in services/ai/models.ts while its tokens are still counted.
#
# Gemini is used ONLY when AI_PROVIDER says so: a key sitting here does not silently
# redirect anything. See "Model providers" in CLAUDE.md for what differs on that path
# (a reduced tool schema, safety filters off, and extra output headroom for thinking).
GEMINI_API_KEY=""

# ─── Follow-up digest (apps/api) ─────────────────────────────────────
# The ONLY mail this application sends from its own domain, and it never carries the
# user's own correspondence (that goes through their mailbox). Opt-in per user via
# UserSettings.followUpDigest. Leave both empty and reminders still work, resolve and
# appear at /follow-ups — only the email does not go out.
RESEND_API_KEY=""
# A verified sender on the Resend account, and obviously ours rather than the user's.
DIGEST_FROM_ADDRESS=""

# ─── Gmail push notifications (apps/api) ─────────────────────────────
# Real-time sync. Full setup, step by step, in docs/gmail-push-setup.md.
#
# Leave GMAIL_PUBSUB_TOPIC empty to run without push: mailboxes still sync
# through the backfill, and the hourly keeper still sweeps them, just not in
# real time. `startWatch` refuses with a clear error rather than half-working.
GMAIL_PUBSUB_TOPIC=""
# The `aud` claim to require on the push subscription's OIDC token — whatever was
# configured with --push-auth-token-audience. Empty means API_PUBLIC_URL +
# /webhooks/gmail, which is the conventional value.
GMAIL_PUBSUB_AUDIENCE=""
# The service account the push subscription authenticates as. Setting it is what
# stops anyone with any Google service account from minting a token for this URL.
GMAIL_PUBSUB_SERVICE_ACCOUNT=""
# Development only: a shared secret accepted in place of a Google OIDC token, so
# the webhook can be driven locally without a public URL. Ignored entirely when
# NODE_ENV=production, and every request that uses it logs a warning.
GMAIL_WEBHOOK_DEV_TOKEN=""
