# ─── Local infrastructure (matches docker-compose.yml) ───────────────
DATABASE_URL="postgresql://inbox:inbox@localhost:5432/inbox_copilot?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Core API (apps/api) ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
LOG_LEVEL="debug"
API_PUBLIC_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"

# ─── Secrets ─────────────────────────────────────────────────────────
# Generate every value in this block with:  node scripts/generate-secrets.mjs
#
# TOKEN_ENCRYPTION_KEY: AES-256-GCM key for the OAuth token vault. 32 bytes,
# base64. Bump the VERSION when you rotate it; rows keep their own keyVersion.
TOKEN_ENCRYPTION_KEY=""
TOKEN_ENCRYPTION_KEY_VERSION=1
# HMAC secret for the mailbox-connect OAuth `state` parameter (CSRF).
OAUTH_STATE_SECRET=""
# Auth.js session cookie secret.
AUTH_SECRET=""
# RS256 keypair for the internal web→api JWT. Private key: web only.
INTERNAL_JWT_PRIVATE_KEY=""
INTERNAL_JWT_PUBLIC_KEY=""

# ─── Web app (apps/web) ──────────────────────────────────────────────
AUTH_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"

# ─── OAuth: sign-in (apps/web, Auth.js) ──────────────────────────────
# Scopes are fixed in apps/web/auth.ts: openid profile email. No mail scopes.
# Google redirect URI:    http://localhost:3000/api/auth/callback/google
# Microsoft redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT="common"

# ─── OAuth: mailbox connection (apps/api) ────────────────────────────
# The same provider app may be reused, but these redirect URIs must also be
# registered — the mailbox flow is answered by the API, not the web app:
# Google redirect URI:    http://localhost:4000/oauth/google/callback
# Microsoft redirect URI: http://localhost:4000/oauth/microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
