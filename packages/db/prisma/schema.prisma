// packages/db/prisma/schema.prisma
// Inbox Copilot — data model
// Design rules:
//   1. Every provider-specific field is isolated; the rest of the app reads normalized rows.
//   2. Every AI output is cached against a content hash so we never pay twice for the same input.
//   3. Every row that belongs to a user carries userId for tenancy filtering.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth.js core (adapter-compatible — do not rename these fields)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("UTC") // IANA, e.g. "Africa/Tunis"
  locale        String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  mailAccounts      MailAccount[]
  writingStyle      UserWritingStyle?
  settings          UserSettings?
  scheduled         ScheduledEmail[]
  reminders         FollowUpReminder[]
  usage             AiUsage[]
  threatAppeals     ThreatAppeal[]
  mailAccountEvents MailAccountEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "google" | "microsoft-entra-id"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Connected mailboxes
// ─────────────────────────────────────────────────────────────

enum MailProviderType {
  GMAIL
  OUTLOOK
}

enum SyncStatus {
  PENDING
  BACKFILLING
  ACTIVE
  PAUSED
  ERROR
  REVOKED
}

/// One row per connected mailbox. A user may connect several.
/// Tokens are AES-256-GCM ciphertext — never plaintext, never sent to the client.
enum MailAccountEventKind {
  CONNECTED
  RECONNECTED
  DISCONNECTED
}

/// Audit trail for mailbox connect and disconnect.
///
/// It exists because a mailbox once vanished with no persisted record of what
/// removed it: the only evidence was a log line on stdout, which is gone the moment
/// the process is. A row survives the process, the restart and — critically — the
/// mailbox itself.
///
/// **`mailAccountId` is deliberately a plain String with no foreign key.** A relation
/// to `MailAccount` would cascade, so the disconnect record would be deleted by the
/// very delete it exists to document. The cost of that choice is that the column can
/// name a row that no longer exists, which for an audit trail is the point rather
/// than a defect.
///
/// The `User` relation *does* cascade: a deleted user is account closure, and keeping
/// their mailbox addresses after it would be keeping personal data with nobody left to
/// show it to.
model MailAccountEvent {
  id     String               @id @default(cuid())
  kind   MailAccountEventKind
  userId String

  /// The mailbox this happened to. Not a foreign key — see above.
  mailAccountId String
  provider      MailProviderType
  /// Which mailbox, in the form a person would recognize.
  emailAddress  String

  /// Correlates the row with the API log line for the same request (lib/requestId.ts).
  /// Null for anything that did not arrive as a request.
  requestId String?

  /// Disconnect only: whether the grant was actually revoked at the provider.
  grantRevoked Boolean?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([mailAccountId])
}

model MailAccount {
  id           String           @id @default(cuid())
  userId       String
  provider     MailProviderType
  emailAddress String
  displayName  String?

  // Encrypted token vault. Each ciphertext gets its own iv + authTag — a GCM
  // nonce must never be reused across two encryptions under the same key.
  // `keyVersion` covers both and exists so the key can be rotated.
  accessTokenEnc      String?   @db.Text
  accessTokenIv       String?
  accessTokenAuthTag  String?
  refreshTokenEnc     String?   @db.Text
  refreshTokenIv      String?
  refreshTokenAuthTag String?
  keyVersion          Int       @default(1)
  tokenExpiresAt      DateTime?
  tokenRefreshedAt    DateTime?
  scopes              String[]

  // sync cursors — Gmail uses historyId, Graph uses a deltaLink URL
  syncCursor      String?    @db.Text
  syncStatus      SyncStatus @default(PENDING)
  syncError       String?    @db.Text
  lastSyncedAt    DateTime?
  backfilledUntil DateTime?

  /// In-progress backfill checkpoint, so a retried job resumes instead of
  /// restarting. `backfillPageToken` is the next page to read; `backfillCursor` is
  /// the history pointer captured when the run began — a resume must keep the
  /// original, because re-reading it later would skip everything that arrived
  /// during the attempt that failed. Both are cleared when the backfill completes.
  backfillPageToken String? @db.Text
  backfillCursor    String?

  // push notification subscription
  watchResourceId  String?
  watchExpiresAt   DateTime?
  watchClientState String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads   Thread[]
  messages  Message[]
  scheduled ScheduledEmail[]

  @@unique([provider, emailAddress, userId])
  @@index([userId])
  @@index([syncStatus, watchExpiresAt])
}

// ─────────────────────────────────────────────────────────────
// Normalized mail
// ─────────────────────────────────────────────────────────────

enum Category {
  PRIMARY
  WORK
  PERSONAL
  FINANCE
  NEWSLETTER
  PROMOTION
  SOCIAL
  NOTIFICATION
  TRAVEL
  SPAM
  OTHER
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

model Thread {
  id               String @id @default(cuid())
  mailAccountId    String
  providerThreadId String

  subject        String?  @db.Text
  snippet        String?  @db.Text
  participants   Json // [{ name, email, role: "from"|"to"|"cc" }]
  messageCount   Int      @default(0)
  firstMessageAt DateTime
  lastMessageAt  DateTime

  isRead     Boolean @default(false)
  isStarred  Boolean @default(false)
  isArchived Boolean @default(false)
  isTrashed  Boolean @default(false)

  // AI-derived, denormalized onto the thread for fast list queries
  category      Category?
  priority      Priority?
  priorityScore Int? // 0-100
  threatLevel   ThreatLevel @default(UNKNOWN)
  needsReply    Boolean     @default(false)
  language      String?

  providerLabels String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailAccount MailAccount        @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  messages    Message[]
  summaries   AiSummary[]
  replyDrafts ReplyDraft[]
  reminders   FollowUpReminder[]
  scheduled   ScheduledEmail[]

  @@unique([mailAccountId, providerThreadId])
  @@index([mailAccountId, lastMessageAt(sort: Desc)])
  @@index([mailAccountId, category, lastMessageAt(sort: Desc)])
  @@index([mailAccountId, priorityScore(sort: Desc)])
}

model Message {
  id                String  @id @default(cuid())
  threadId          String
  mailAccountId     String
  providerMessageId String
  internetMessageId String? // RFC 5322 Message-ID — used for threading on send

  fromName  String?
  fromEmail String
  to        String[]
  cc        String[]
  bcc       String[]
  replyTo   String?

  subject  String? @db.Text
  bodyText String? @db.Text
  bodyHtml String? @db.Text
  snippet  String? @db.Text

  sentAt         DateTime
  isRead         Boolean  @default(false)
  isOutbound     Boolean  @default(false) // sent by the mailbox owner
  isDraft        Boolean  @default(false)
  hasAttachments Boolean  @default(false)

  // raw headers we keep for auth/threading decisions
  headers     Json?
  authResults Json? // { spf, dkim, dmarc, returnPath, displayNameMismatch }

  contentHash String // sha256 of normalized body — the AI cache key

  createdAt DateTime @default(now())

  thread         Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailAccount    MailAccount       @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  attachments    Attachment[]
  classification AiClassification?
  translations   Translation[]
  threatAppeal   ThreatAppeal?

  @@unique([mailAccountId, providerMessageId])
  @@index([threadId, sentAt])
  @@index([fromEmail])
  @@index([contentHash])
}

model Attachment {
  id                   String  @id @default(cuid())
  messageId            String
  providerAttachmentId String?
  filename             String
  mimeType             String
  sizeBytes            Int
  isInline             Boolean @default(false)
  riskFlag             String? // "executable" | "macro" | "archive" | null

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ─────────────────────────────────────────────────────────────
// AI outputs — all cached by contentHash
// ─────────────────────────────────────────────────────────────

model AiSummary {
  id          String   @id @default(cuid())
  threadId    String
  contentHash String // hash of the concatenated thread at summarization time
  model       String
  headline    String   @db.Text
  summary     String   @db.Text
  keyPoints   Json // string[]
  actionItems Json // [{ text, owner, dueDate? }]
  createdAt   DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, contentHash])
  @@index([threadId])
}

enum ThreatLevel {
  UNKNOWN
  SAFE
  SUSPICIOUS
  PHISHING
  SPAM
}

model AiClassification {
  id        String @id @default(cuid())
  messageId String @unique

  category      Category
  priority      Priority
  priorityScore Int
  needsReply    Boolean
  language      String
  confidence    Float

  threatLevel   ThreatLevel
  threatScore   Int // 0-100
  threatReasons Json // string[] shown to the user
  ruleSignals   Json // deterministic layer-1/2 findings, pre-LLM

  /// Layer 3: what the model judged the sender was trying to do, and how it
  /// explained that to the user. Null until the message has been assessed, or when
  /// the rules ran alone (AI off, or the daily cap spent) — the deterministic
  /// layers do not need the model to produce a verdict.
  threatIntent      String?
  threatExplanation String? @db.Text
  /// The model that produced the interpretation, which is not the model in
  /// `model` below: classification runs on Haiku and threat assessment does not.
  threatModel       String?

  model       String
  contentHash String
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([contentHash])
}

/// A user disagreeing with a threat verdict — the appeal path §6 asks for.
///
/// Recorded *beside* the verdict rather than overwriting it: the rules and the
/// model said what they said, and an assessment that quietly rewrites itself when
/// somebody clicks "safe" leaves nothing to measure a false-positive rate against.
/// The UI reads this to stand the banner down; the scoring never reads it.
model ThreatAppeal {
  id        String @id @default(cuid())
  userId    String
  messageId String @unique

  /// The verdict as it stood when the user disagreed with it.
  claimedLevel ThreatLevel
  claimedScore Int
  /// The reasons shown to them at that moment, so the appeal can be read back
  /// against what they were actually told.
  shownReasons Json
  note         String?     @db.Text

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ReplyTone {
  PROFESSIONAL
  FRIENDLY
  CONCISE
  FORMAL
  APOLOGETIC
  ENTHUSIASTIC
}

model ReplyDraft {
  id         String    @id @default(cuid())
  threadId   String
  tone       ReplyTone
  body       String    @db.Text
  editedBody String?   @db.Text
  wasUsed    Boolean   @default(false) // feedback signal for prompt tuning
  model      String
  createdAt  DateTime  @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Translation {
  id             String   @id @default(cuid())
  messageId      String
  targetLang     String
  translatedText String   @db.Text
  sourceLang     String?
  contentHash    String
  model          String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLang])
}

/// Extracted from the user's own sent mail during backfill.
/// Injected into every reply/compose prompt — the main quality lever.
model UserWritingStyle {
  id             String   @id @default(cuid())
  userId         String   @unique
  greeting       String?
  signOff        String?
  formality      String? // "casual" | "neutral" | "formal"
  avgSentenceLen Int?
  usesEmoji      Boolean  @default(false)
  descriptor     String?  @db.Text // free-form style summary for the prompt
  sampleCount    Int      @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  feature      String // "summarize" | "classify" | "reply" | "compose" | "translate" | "phishing"
  model        String
  inputTokens  Int
  outputTokens Int
  cachedTokens Int      @default(0)
  costUsd      Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Scheduling & follow-ups
// ─────────────────────────────────────────────────────────────

enum ScheduleStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledEmail {
  id            String  @id @default(cuid())
  userId        String
  mailAccountId String
  threadId      String?

  to       String[]
  cc       String[]
  bcc      String[]
  subject  String   @db.Text
  bodyHtml String   @db.Text
  bodyText String?  @db.Text

  sendAt   DateTime
  timezone String

  status            ScheduleStatus @default(SCHEDULED)
  idempotencyKey    String         @unique
  attempts          Int            @default(0)
  lastError         String?        @db.Text
  sentAt            DateTime?
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailAccount MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  thread      Thread?     @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([status, sendAt]) // sweeper query
  @@index([userId, sendAt])
}

enum ReminderStatus {
  PENDING
  TRIGGERED
  RESOLVED
  SNOOZED
  DISMISSED
}

model FollowUpReminder {
  id       String @id @default(cuid())
  userId   String
  threadId String

  /// the outbound message we're waiting on a reply to
  watchedMessageId String
  reason           String?        @db.Text
  dueAt            DateTime
  snoozedUntil     DateTime?
  status           ReminderStatus @default(PENDING)
  resolvedAt       DateTime?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([userId, status])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  aiEnabled          Boolean   @default(true)
  autoSummarize      Boolean   @default(true)
  autoCategorize     Boolean   @default(true)
  phishingProtection Boolean   @default(true)
  defaultTone        ReplyTone @default(PROFESSIONAL)
  translationLang    String?
  followUpDays       Int       @default(3)
  dailyAiCallCap     Int       @default(500)
  storeFullBodies    Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
